# NextAuth
NEXTAUTH_URL=http://localhost:3000
# `openssl rand -base64 32` などで生成
NEXTAUTH_SECRET=

# GitHub OAuth App（https://github.com/settings/developers）
# Callback URL: <NEXTAUTH_URL>/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=
# ログインを許可する GitHub ユーザー名（カンマ区切り）。空なら誰でもログイン可
ALLOWED_GITHUB_USERS=

# 開発時のみ: GitHub を使わない「開発用ログイン」を表示する
AUTH_DEV_LOGIN=false

# 資料の保存先（既定: apps/web/data）
# SLIDEA_DATA_DIR=
