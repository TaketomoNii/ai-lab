#!/usr/bin/env bash
set -e

# husky.sh があれば読み込む（無くても続行）
if [ -f "$(dirname -- "$0")/_/husky.sh" ]; then
  . "$(dirname -- "$0")/_/husky.sh"
fi

# apps/web で整形（失敗しても続行）
npm -C "$(git rev-parse --show-toplevel)/apps/web" run -s format || true

# ★ lint-staged の作業ディレクトリを apps/web に固定
npx --yes lint-staged --cwd "$(git rev-parse --show-toplevel)/apps/web"
